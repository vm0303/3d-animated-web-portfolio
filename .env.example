# Hostinger Node.js production mode.
# Hostinger can also set PORT automatically for the managed Node.js app.
NODE_ENV=production

# Contact / EmailJS server-side delivery.
# These use the same EmailJS values as the existing VITE_* variables, but the
# production backend should use non-VITE names so the values are not exposed to
# the browser bundle.
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Optional. Use this only if Private Key is enabled in your EmailJS account.
EMAILJS_PRIVATE_KEY=

# Persistent 3-hour cooldown shared by Chrome, Edge, Firefox, Safari, private
# browsing, and other browsers. Create an Upstash Redis database and copy the
# REST URL and standard token from its console.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Long random value used only to HMAC email/IP identifiers before they are
# stored as Redis keys. Never reuse an account password or email password here.
CONTACT_COOLDOWN_SECRET=replace_with_a_long_random_secret

# Optional override. Default is 10800 seconds (3 hours).
CONTACT_COOLDOWN_SECONDS=10800

# Existing local VITE_* EmailJS variables remain accepted by the Contact API as
# a compatibility fallback during local development. Production Hostinger
# settings should use the non-VITE EMAILJS_* variables above.
