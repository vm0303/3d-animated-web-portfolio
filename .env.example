# Contact / EmailJS server-side delivery
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Optional. Use this only if Private Key is enabled in your EmailJS account.
EMAILJS_PRIVATE_KEY=

# Persistent 3-hour cooldown for deployed preview/production environments.
# Create an Upstash Redis database and copy its REST credentials here.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Long random value used to HMAC email/IP identifiers before they are stored.
CONTACT_COOLDOWN_SECRET=replace_with_a_long_random_secret

# Optional override. Default is 10800 seconds (3 hours).
CONTACT_COOLDOWN_SECONDS=10800

# Existing local VITE_* EmailJS variables are still accepted by the local
# Contact API as a temporary compatibility fallback, but new deployments
# should use the non-VITE server variables above.
